{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/book",
      "destination": "https://customer.moovs.app/nyc-lux-ride/request/new",
      "permanent": false
    },
    {
      "source": "/fleet/:name.jpg",
      "destination": "/fleet/:name.webp",
      "statusCode": 301
    },
    {
      "source": "/home.webp",
      "destination": "/hero-new.webp",
      "statusCode": 301
    }
  ],
  "headers": [
    {
      "source": "/assets/(.+\\.[A-Za-z0-9_-]{6,}\\.(js|css|webp|webmanifest))",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        }
      ]
    }
  ]
}
