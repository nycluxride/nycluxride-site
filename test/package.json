{
  "name": "nlr-tracking-tests",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Dev-only regression tests. NOT deployed (excluded via /.vercelignore); no root package.json, so Vercel still treats the repo as a static site.",
  "scripts": {
    "test": "node run-all.mjs",
    "test:static": "node run-all.mjs --static",
    "test:browser": "node redesign-browser.test.mjs && node book-browser.test.mjs",
    "test:redesign": "node redesign-browser.test.mjs"
  },
  "devDependencies": {
    "@vercel/routing-utils": "^6.6.0",
    "jsdom": "^24.1.3",
    "path-to-regexp": "^6.1.0",
    "playwright": "^1.61.1"
  }
}
